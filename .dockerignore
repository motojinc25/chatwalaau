# .dockerignore
# ============================================================
# Docker build-context exclusion list. Mirrors `.gitignore` for
# the parts that matter to the image build; leaves anything else
# in so multi-stage COPY directives stay reliable.
# Referenced by: assets/docker/Dockerfile (build context = repo root)
# ============================================================

# ---- Git internals ----
.git/
.gitignore
.gitattributes

# ---- Python build artifacts and caches ----
backend/.venv/
backend/.ruff_cache/
backend/.pytest_cache/
backend/dist/
backend/build/
backend/src/*.egg-info/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/**/*.pyd

# Locally bundled SPA assets (stage 1 rebuilds them inside the image).
backend/src/app/_frontend_dist/

# Locally generated PyPI helper file (recreated by bundle-frontend.mjs).
backend/LICENSE.md

# ---- Node / frontend build artifacts ----
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ---- Marketing site build artifacts (assets/docker/Dockerfile.site) ----
# Stage 1 reinstalls deps and rebuilds the static site inside the image, so the
# local copies must stay out of the build context (and not clobber the COPY).
site/frontend/node_modules/
site/frontend/build/
site/frontend/.docusaurus/
site/backend/.venv/
site/backend/.ruff_cache/
site/backend/.pytest_cache/
site/backend/dist/
site/backend/**/__pycache__/
site/backend/**/*.pyc
site/backend/.leads/

# ---- Environment / secrets ----
**/.env
**/.env.local
**/.env.*.local
# Keep the template so operators inside the image can `chatwalaau init`. It is the
# SOLE env-layout artifact (PRP-0137 / UDR-0121 D1); the mirrored backend/.env.sample
# was retired in v0.130.0 because a hand-maintained copy of an SSOT is kept honest
# only by a CI failure that says nothing about the system.
!backend/src/app/templates/.env.template

# ---- Runtime data (operator-side state) ----
backend/.sessions/
backend/.uploads/
backend/.archived/
backend/.certs/
backend/.pipeline/
backend/.jobs/
backend/.chroma/
backend/.skills/
backend/.templates/
backend/.cron/
backend/.agent/
backend/.agents/
backend/.webhooks/
backend/.prompts/
backend/.ontologies/
backend/.auth/
backend/batch-server.log

# Operator-owned Model Offering Catalog (CTR-0174): runtime state that belongs on
# persistent storage via MODEL_OFFERINGS_FILE, NEVER baked into the image. A baked
# copy would otherwise be served whenever MODEL_OFFERINGS_FILE is unset/relative
# (CWD = /app/backend), hijacking the operator's configured path.
backend/model_offerings.jsonc
backend/model_offerings.jsonc.*.tmp

# Operator-owned Application Settings store (CTR-0198): same reasoning as the
# catalog above. It belongs on persistent storage via APP_SETTINGS_FILE, and a
# baked copy would be served whenever that path is unset/relative (CWD =
# /app/backend), silently overriding the operator's real settings with whatever
# happened to be on the build machine.
backend/app_settings.jsonc
backend/app_settings.jsonc.*.tmp

# ---- IDE / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Docs that are not needed in the runtime image ----
assets/
tests/
.releases/
RELEASE_NOTES*.md
CHANGELOG.md
CLAUDE.md
