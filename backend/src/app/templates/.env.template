# ==========================================
# = ChatWalaʻau Configuration
# = The localhost AI Agent Runtime - Chat UI, Tools, RAG, and MCP in one pip install.
# ==========================================

# >>> Show upstream Microsoft Agent Framework experimental warnings at startup
#SHOW_EXPERIMENTAL_WARNINGS=false

# >>> CLI client configuration
# > Base URL for CLI client subcommands
# > API key for CLI client authentication (reuses API_KEY if not set)
#CHATWALAAU_URL=http://localhost:8000
#CHATWALAAU_API_KEY=

# ------------------------------------------

# >>> Web SPA Authentication
# > Optional ID/PW + opaque session cookie lane for cloud-deployed SPAs.
# > Leave AUTH_USERNAME empty to disable.
# > When set, AUTH_PASSWORD_HASH is required.
# > verify_api_key accepts EITHER Bearer API_KEY OR a valid session cookie.
# > The strict /v1/responses path is Bearer-only.
# > Generate the hash with: `chatwalaau hash-password`
#AUTH_USERNAME=
#AUTH_PASSWORD_HASH=
#AUTH_SESSION_TTL_SECONDS=86400
#AUTH_COOKIE_SECURE=auto
#AUTH_COOKIE_NAME=chatwalaau_session
# > Session-cookie SameSite policy: lax (default) | strict | none.
# > behind a TLS-terminating tunnel / reverse proxy (e.g. Microsoft Dev Tunnels) -- "strict"
# > can drop the cookie on cross-site entry and cause a login redirect loop. "none" requires (and forces) a Secure cookie.
#AUTH_COOKIE_SAMESITE=lax
# > Persist session token DIGESTS (sha256, never the raw token) across a backend restart.
# > Only active when AUTH_USERNAME is set. false = in-memory only.
#AUTH_SESSION_PERSIST=true
# > Where the digest store lives. Never contains a raw token. Delete the file to log every user out; rotating AUTH_PASSWORD_HASH has the same effect.
#AUTH_SESSION_STORE_PATH=.auth/session_tokens.json

# >>> Server Settings
#APP_HOST=127.0.0.1
#APP_PORT=8000
#APP_DEBUG=false
# > Frontend dist directory
#FRONTEND_DIST=../frontend/dist
# > CORS (comma-separated origins)
#CORS_ALLOWED_ORIGINS=http://localhost:5173
# > HTTPS / TLS for LAN access with Secure Context
# > Generate certificates with mkcert: mkcert <your-ip> localhost 127.0.0.1
#APP_SSL_CERTFILE=<path-to-cert.pem, e.g. .certs/cert.pem>
#APP_SSL_KEYFILE=<path-to-key.pem, e.g. .certs/key.pem>

# >>> API Authentication
# > API_KEY is the unified Bearer token for:
# >   - External-app access to /v1/responses (always required)
# >   - Write endpoints (image edit, upload, MCP Apps RPC, sessions write, templates write, TTS, STT) when the CLIENT connects from a non-loopback address
# > Same-machine clients (127.0.0.1, ::1, localhost) always bypass auth, even when APP_HOST=0.0.0.0 for LAN exposure.
#API_KEY=
# > Enforce Bearer API_KEY on write endpoints for non-loopback clients Default true (fail-closed).
# > Set to false only if an operator explicitly accepts unauthenticated LAN exposure.
#APP_REQUIRE_AUTH_ON_LAN=true

# >>> Application settings store
# > Path to the operator-owned application settings file (JSONC).
#APP_SETTINGS_FILE=app_settings.jsonc

# >>> Model Offering Catalog
# > Author it with `chatwalaau models add|edit|remove` (offline), the in-app Model Settings screen (hot-reloads without a restart), or by hand.
#MODEL_OFFERINGS_FILE=model_offerings.jsonc

# >>> MCP Integration
# > Two-tier resolution: the runtime first tries this filename, then falls back to the bundled mcp_servers.default.jsonc in the same directory.
#MCP_CONFIG_FILE=mcp_servers.jsonc

# >>> Slash Commands
# > Optional operator override for the slash command registry. The four built-in commands (/help, /prompt, /skill, /model) are code-backed and always available.
# > Two-tier resolution: the runtime tries this filename, then falls back to a bundled commands.default.jsonc in the same directory.
#COMMANDS_CONFIG_FILE=commands.jsonc

# >>> MCP Apps (interactive UI in chat via sandboxed iframe)
# > Sandbox proxy runs on a separate port for origin isolation.
# > Activated automatically when MCP tools declare _meta.ui resources.
#MCP_APPS_SANDBOX_PORT=8081

# >>> DevUI Development debug UI for agent testing
#DEVUI_ENABLED=false
#DEVUI_PORT=8080
#DEVUI_AUTH_ENABLED=true
#DEVUI_AUTH_TOKEN=
#DEVUI_TRACING=false
#DEVUI_MODE=developer
#DEVUI_DISABLE_MCP=true
#DEVUI_DISABLE_RAG=true

# >>> Declarative Workflows
# > A `kind: Workflow` entity is discovered from the SAME DECLARATIVE_AGENTS_DIR tree as `kind: Prompt` agents (dispatched by `kind`).
# > InvokeFunctionTool exposes only the deployment's agent-equivalent function tools (coding still gated by CODING_ENABLED).
# > InvokeMcpTool reaches only configured + tool-manager-enabled MCP servers (YAML serverUrl/headers ignored).
# > HttpRequestAction is behind a host allow-list + SSRF guard.
# > Comma-separated host allow-list for HttpRequestAction (empty = deny all).
#WORKFLOW_FUNCTION_ACTIONS_ENABLED=false
#WORKFLOW_MCP_ACTIONS_ENABLED=false
#WORKFLOW_HTTP_ACTIONS_ENABLED=false
#WORKFLOW_HTTP_ALLOWED_HOSTS=<comma-separated-hosts, e.g. api.openai.com,graph.microsoft.com>

# >>> Microsoft Teams integration
# > Converse with the agent from a Teams personal chat, group chat, or channel.
# > Local dev needs a public tunnel (Microsoft Dev Tunnels default; ngrok / cloudflared) and a registered bot.
# > Inbound is authenticated by Microsoft Bot Framework JWT (not API_KEY).
# > Object-ID allow-list adds per-sender authorization.
#TEAMS_ENABLED=false
#TEAMS_APP_ID=<your-entra-app-client-id>
#TEAMS_APP_PASSWORD=<your-entra-app-client-secret>
#TEAMS_TENANT_ID=<your-entra-tenant-id>
# > Comma-separated Microsoft Entra ID Object IDs (aadObjectId) allowed to use the bot.
# > Leave blank to allow everyone (no restriction).
#TEAMS_ALLOWED_USERS=<comma-separated-aadObjectIds>
# > Inbound path mounted and registered as the bot messaging endpoint.
#TEAMS_MESSAGING_ENDPOINT_PATH=/api/teams/messages

# >> Agent Harness Conversation Compaction
#COMPACTION_KEEP_LAST_GROUPS=4
#COMPACTION_PRESERVE_SYSTEM=true

# >>> Agent Harness Tool Approval Flow
# > Allowed modes:
# >   - skip: No tool is wrapped; the SPA renders PermissionsDisabledBanner.
# >   - auto: (default) Tools in TOOL_APPROVAL_REQUIRE_LIST require approval.
# >   - always: Every non-readonly tool requires approval.
# > TOOL_APPROVAL_REQUIRE_LIST is the comma-separated list of tool __name__s (default: bash_execute,file_write).
# > TOOL_APPROVAL_TIMEOUT_SEC bounds how long the parked AG-UI stream waits for POST /api/tool-approval (range 5..86400).
# > TOOL_APPROVAL_ARG_MAX_CHARS caps per-field argument preview length in the AG-UI CUSTOM event (the full value still reaches the tool on approval).
# > TOOL_APPROVAL_MAX_ITERATIONS bounds the human-interactive approval rounds per turn (default 33, range 1..1000). Rounds resolved from a "approve for session" grant do NOT count against it.
# > TOOL_APPROVAL_ABSOLUTE_MAX_ITERATIONS is the runaway-agent backstop counting EVERY round incl. session-cached ones (default 200, range 1..100000, must be >= TOOL_APPROVAL_MAX_ITERATIONS).
#TOOL_APPROVAL_MODE=auto
#TOOL_APPROVAL_REQUIRE_LIST=bash_execute,file_write
#TOOL_APPROVAL_TIMEOUT_SEC=300
#TOOL_APPROVAL_ARG_MAX_CHARS=4096
#TOOL_APPROVAL_MAX_ITERATIONS=33
#TOOL_APPROVAL_ABSOLUTE_MAX_ITERATIONS=200

# >>>  Inbound Webhook Gateway
# > When false the /api/webhook/* ingress + /api/webhooks/* management routers 404, the maintenance scheduler does not run.
# > The first source is Microsoft Graph (Teams meeting transcripts). Local dev needs a public tunnel.
#WEBHOOK_ENABLED=false
# > Public base path for inbound notifications; sources mount at <base>/{source}.
#WEBHOOK_INGRESS_BASE_PATH=/api/webhook
# > Cap per captured receipt record body in bytes (0 = unbounded).
#WEBHOOK_RECEIPT_MAX_BYTES=1048576
# > clientState shared secret used to validate Microsoft Graph notifications (HMAC-safe).
#MSGRAPH_WEBHOOK_CLIENT_STATE=
# > Public, tunnel-reachable notification URL given to Graph at subscribe time.
#MSGRAPH_WEBHOOK_NOTIFICATION_URL=
# > Graph resource to subscribe (e.g. communications/onlineMeetings/getAllTranscripts).
#MSGRAPH_WEBHOOK_RESOURCE=
# > Subscription renewal interval in hours (default 12; MUST be shorter than the resource max expiry). Auto-renewal runs only while CRON_ENABLED.
#MSGRAPH_SUBSCRIPTION_RENEW_HOURS=12
# > Optional source CIDR allowlist (comma-separated; empty = off).
#MSGRAPH_WEBHOOK_ALLOWED_CIDRS=
# > Optional resource allowlist (comma-separated; empty = off).
#MSGRAPH_WEBHOOK_ALLOWED_RESOURCES=

# >>> Microsoft Graph app-only credentials
# > Used by the webhook gateway to manage subscriptions and fetch meetings/transcripts.
# > May point to the same Entra app registration as TEAMS_* (with Graph application permissions added); kept separate so the two trust models do not get conflated.
# > Teams transcript access needs TWO grants and NEITHER is configured here:
# >   1. Entra: OnlineMeetingTranscript.Read.All (+ a Teams Application Access Policy on the app-only lane).
# >   2. TENANT: Teams admin center -> Meetings -> Meeting settings -> Transcript API access -> "Microsoft Graph access" = On.
#GRAPH_TENANT_ID=
#GRAPH_CLIENT_ID=
#GRAPH_CLIENT_SECRET=
#GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# >>> Teams meeting transcript summarization
# > The teams-meeting pipeline job (registered when WEBHOOK_ENABLED + PIPELINE_ENABLED) writes a summary JSON into the coding workspace (CODING_WORKSPACE_DIR jail).
#TEAMS_MEETING_OUTPUT_DIR=meeting-summaries
# > A transcript artifact is often not ready right when a meeting ends; the fetch stage polls for it up to this many seconds before failing.
#TEAMS_MEETING_TRANSCRIPT_MAX_WAIT_SECONDS=600
# > Poll interval while waiting for the transcript artifact.
#TEAMS_MEETING_TRANSCRIPT_POLL_SECONDS=30

# >>> Azure OpenAI Configuration
# > Endpoint URL for Azure OpenAI resource. Required for all Azure OpenAI lanes.
#AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# > Authentication, decision matrix (highest precedence wins):
# >   - AZURE_OPENAI_API_KEY set -> api-key lane (works on localhost and Azure cloud, bypasses Entra ID entirely)
# >   - AZURE_OPENAI_API_KEY unset + AZURE_CREDENTIAL_MODE=cli (default) -> AzureCliCredential() / az login (localhost development, personal box)
# >   - AZURE_OPENAI_API_KEY unset + AZURE_CREDENTIAL_MODE=managed-identity -> ManagedIdentityCredential() (Azure App Service assign the Managed Identity the "Cognitive Services OpenAI User" role on the Azure OpenAI resource)
# >   - AZURE_OPENAI_API_KEY unset + AZURE_CREDENTIAL_MODE=default -> DefaultAzureCredential(exclude_interactive_browser_credential=True) (auto-discovery: env -> WorkloadIdentity -> ManagedIdentity -> SharedToken -> AzureCli -> ...)
#AZURE_OPENAI_API_KEY=
#AZURE_CREDENTIAL_MODE=cli
# > Required for tenant pinning under cli / default credential modes; ignored by managed-identity mode and the api-key lane.
#AZURE_TENANT_ID=

# >>> OpenAI Configuration
# > The public OpenAI API authenticates by API key only (no Entra ID lane).
#OPENAI_API_KEY=<your-openai-api-key, e.g. sk-...>

# >>> ElevenLabs Configuration
# Consumed when the TTS provider is elevenlabs.
#ELEVENLABS_API_KEY=<your-elevenlabs-api-key, e.g. 1234567890abcdef>

# >>> Microsoft Foundry Configuration
# > Endpoint URL for Microsoft Foundry resource.
#FOUNDRY_PROJECT_ENDPOINT=

# >>> Anthropic Configuration
# >> Direct hosting auth (ANTHROPIC_HOSTING=direct)
#ANTHROPIC_API_KEY=<your-anthropic-api-key, e.g. sk-...>

