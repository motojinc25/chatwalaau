#PROMPT_DUMP_ENABLED=false
#PROMPT_DUMP_DIR=.prompts

# >>> Pipeline Jobs directory
#PIPELINE_ENABLED=true
#PIPELINE_JOBS_DIR=.pipeline

# >>> Ontology directory (for RDF concept models)
#ONTOLOGY_ENABLED=false
#ONTOLOGY_DIR=.ontologies

# >>> Coding workspace directory
#CODING_ENABLED=false
#CODING_WORKSPACE_DIR=<absolute-path-to-workspace>

# >>> Webhook store directory
#WEBHOOK_STORE_DIR=.webhooks

# >>> Cron Jobs directory
# > ADDITIONALLY requires CODING_ENABLED=true and CODING_WORKSPACE_DIR set.
#CRON_ENABLED=false
#CRON_JOBS_DIR=.cron

# >>> File Explorer
# > ADDITIONALLY requires CODING_ENABLED=true and CODING_WORKSPACE_DIR set.
#FILE_EXPLORER_ENABLED=false

# >>> Demo Mode without LLM cost
# > DEMO_MODE=true replaces every metered external provider (chat, STT, TTS, image generation, RAG embedding) with an in-process deterministic dummy.
# > Weather (Open-Meteo) STAYS LIVE because it's free and key-less.
# > Use with AUTH_USERNAME or API_KEY: DEMO_MODE never relaxes API Authentication Dependency.
# > Comma-separated demo model list for the model selector UI.
# > Per-token streaming delay in milliseconds (range 0..500).
# > Drives the perceived "live typing" effect in the SPA chat UI.
#DEMO_MODE=false
#DEMO_MODELS=gpt-5.6,claude-opus-5
#DEMO_LATENCY_MS=40
